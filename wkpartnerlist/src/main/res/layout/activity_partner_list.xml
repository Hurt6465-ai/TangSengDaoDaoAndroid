<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_partnerlist_page">

    <!-- AppBarLayout 负责顶部标签的滚动收起，避免手工逐帧改高度造成掉帧。 -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_partnerlist_toolbar"
            app:elevation="0dp">

            <LinearLayout
                android:id="@+id/appBarContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll|enterAlways|snap">

                <FrameLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_partnerlist_toolbar"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/backBtn"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/partnerlist_back"
                        android:padding="9dp"
                        android:src="@drawable/ic_partnerlist_back"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/modeTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/partnerModeTab"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minWidth="62dp"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:text="@string/partnerlist_mode_partner"
                            android:textColor="@color/partnerlist_mode_selected"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/datingModeTab"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minWidth="62dp"
                            android:text="@string/partnerlist_mode_dating"
                            android:textColor="@color/partnerlist_mode_normal"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/subtitleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="6dp"
                        android:ellipsize="end"
                        android:maxWidth="190dp"
                        android:singleLine="true"
                        android:text="@string/partnerlist_subtitle_loading"
                        android:textColor="@color/partnerlist_mode_normal"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/quotaTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_partnerlist_quota"
                        android:text="@string/partnerlist_quota_default"
                        android:textColor="@color/partnerlist_quota_text"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/statusHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="5dp"
                    android:background="@drawable/bg_partnerlist_hint"
                    android:text="@string/partnerlist_status_preparing"
                    android:textColor="@color/partnerlist_hint_text"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/listContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:scrollbars="none"
                android:visibility="gone" />

            <com.chat.partnerlist.SkeletonPulseLayout
                android:id="@+id/skeletonLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <include layout="@layout/item_partner_list_skeleton" />
                <include layout="@layout/item_partner_list_skeleton" />
                <include layout="@layout/item_partner_list_skeleton" />
                <include layout="@layout/item_partner_list_skeleton" />
                <include layout="@layout/item_partner_list_skeleton" />
                <include layout="@layout/item_partner_list_skeleton" />
            </com.chat.partnerlist.SkeletonPulseLayout>

            <LinearLayout
                android:id="@+id/errorLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/errorTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/partnerlist_surface_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/retryBtn"
                    android:layout_width="112dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_partnerlist_greeting"
                    android:gravity="center"
                    android:text="@string/partnerlist_retry"
                    android:textColor="@color/partnerlist_quota_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/partnerlist_empty"
                    android:textColor="@color/partnerlist_surface_text"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/completeProfileBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_partnerlist_hint"
                    android:text="@string/partnerlist_complete_profile"
                    android:textColor="@color/partnerlist_hint_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/tab_bg"
        android:clipToPadding="false"
        app:itemIconTint="@color/transparent"
        app:menu="@menu/menu_navigation" />

    <TextView
        android:id="@+id/updateBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="92dp"
        android:background="@drawable/bg_partnerlist_update_banner"
        android:elevation="8dp"
        android:textColor="#FFFFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
