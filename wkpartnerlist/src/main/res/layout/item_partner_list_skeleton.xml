<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="136dp"
    android:layout_marginStart="16dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="7dp"
    app:cardBackgroundColor="@color/partnerlist_card_base"
    app:cardCornerRadius="22dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_partnerlist_card"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="12dp"
        android:paddingBottom="13dp">

        <View
            android:id="@+id/skeletonAvatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_partnerlist_skeleton_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/skeletonActive"
            android:layout_width="62dp"
            android:layout_height="13dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_partnerlist_skeleton_bar"
            app:layout_constraintEnd_toEndOf="@id/skeletonAvatar"
            app:layout_constraintStart_toStartOf="@id/skeletonAvatar"
            app:layout_constraintTop_toBottomOf="@id/skeletonAvatar" />

        <View
            android:id="@+id/skeletonName"
            android:layout_width="116dp"
            android:layout_height="16dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_partnerlist_skeleton_bar"
            app:layout_constraintStart_toEndOf="@id/skeletonAvatar"
            app:layout_constraintTop_toTopOf="@id/skeletonAvatar" />

        <View
            android:id="@+id/skeletonLanguage"
            android:layout_width="94dp"
            android:layout_height="22dp"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_partnerlist_skeleton_bar"
            app:layout_constraintStart_toStartOf="@id/skeletonName"
            app:layout_constraintTop_toBottomOf="@id/skeletonName" />

        <View
            android:id="@+id/skeletonIntro1"
            android:layout_width="0dp"
            android:layout_height="11dp"
            android:layout_marginTop="11dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_partnerlist_skeleton_bar"
            app:layout_constraintEnd_toStartOf="@id/skeletonButton"
            app:layout_constraintStart_toStartOf="@id/skeletonName"
            app:layout_constraintTop_toBottomOf="@id/skeletonLanguage" />

        <View
            android:id="@+id/skeletonIntro2"
            android:layout_width="82dp"
            android:layout_height="10dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_partnerlist_skeleton_bar"
            app:layout_constraintStart_toStartOf="@id/skeletonName"
            app:layout_constraintTop_toBottomOf="@id/skeletonIntro1" />

        <View
            android:id="@+id/skeletonButton"
            android:layout_width="78dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_partnerlist_skeleton_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
