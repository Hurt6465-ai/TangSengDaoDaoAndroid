<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/partnerlist_card_base"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:rippleColor="@color/partnerlist_card_ripple"
    app:strokeColor="@color/partnerlist_card_stroke"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_partnerlist_card_mint"
        android:minHeight="132dp"
        android:paddingStart="13dp"
        android:paddingTop="12dp"
        android:paddingEnd="11dp"
        android:paddingBottom="11dp">

        <View
            android:id="@+id/avatarRing"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/bg_partnerlist_avatar_ring_mint_sky"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/avatarGap"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_partnerlist_avatar_gap"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/avatarRing"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <com.chat.base.ui.components.AvatarView
            android:id="@+id/avatarView"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/partnerlist_avatar"
            app:layout_constraintBottom_toBottomOf="@id/avatarRing"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <View
            android:id="@+id/onlineDot"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_partnerlist_online"
            android:elevation="1dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <TextView
            android:id="@+id/activeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:maxWidth="88dp"
            android:textColor="@color/partnerlist_active_text"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toBottomOf="@id/avatarRing" />

        <LinearLayout
            android:id="@+id/nameRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="6dp"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/greetingBtn"
            app:layout_constraintStart_toEndOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing">

            <TextView
                android:id="@+id/nameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="@color/partnerlist_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/freshBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_partnerlist_fresh_badge"
                android:includeFontPadding="true"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@string/partnerlist_new_recommendation"
                android:textColor="@color/partnerlist_fresh_badge_text"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/newBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_partnerlist_joined_badge"
                android:includeFontPadding="true"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="@string/partnerlist_new"
                android:textColor="@color/partnerlist_joined_badge_text"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/languageRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/nameRow"
            app:layout_constraintStart_toStartOf="@id/nameRow"
            app:layout_constraintTop_toBottomOf="@id/nameRow">

            <TextView
                android:id="@+id/nativeLanguageTv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_partnerlist_language_native"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="48dp"
                android:minWidth="29dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/partnerlist_native_language_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/languageExchangeTv"
                android:layout_width="18dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⇋"
                android:textColor="@color/partnerlist_language_exchange"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/learningLanguageTv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_partnerlist_language_learning"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="48dp"
                android:minWidth="29dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/partnerlist_learning_language_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/introTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/partnerlist_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/nameRow"
            app:layout_constraintTop_toBottomOf="@id/languageRow"
            app:layout_goneMarginTop="5dp" />

        <!-- 固定复用 5 个标签 View，避免 RecyclerView 滑动时反复 inflate/addView。 -->
        <LinearLayout
            android:id="@+id/tagsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:clipChildren="true"
            android:gravity="start|center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/nameRow"
            app:layout_constraintTop_toBottomOf="@id/introTv"
            app:layout_goneMarginTop="0dp">

            <TextView
                android:id="@+id/tag1Tv"
                style="@style/PartnerListTagChip"
                android:background="@drawable/bg_partnerlist_tag_mint" />

            <TextView
                android:id="@+id/tag2Tv"
                style="@style/PartnerListTagChip"
                android:background="@drawable/bg_partnerlist_tag_lavender" />

            <TextView
                android:id="@+id/tag3Tv"
                style="@style/PartnerListTagChip"
                android:background="@drawable/bg_partnerlist_tag_blue" />

            <TextView
                android:id="@+id/tag4Tv"
                style="@style/PartnerListTagChip"
                android:background="@drawable/bg_partnerlist_tag_peach" />

            <TextView
                android:id="@+id/tag5Tv"
                style="@style/PartnerListTagChip"
                android:background="@drawable/bg_partnerlist_tag_rose" />
        </LinearLayout>

        <TextView
            android:id="@+id/greetingBtn"
            android:layout_width="58dp"
            android:layout_height="46dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_partnerlist_greeting"
            android:clickable="true"
            android:elevation="0dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:paddingTop="0dp"
            android:paddingEnd="4dp"
            android:paddingBottom="5dp"
            android:text="@string/partnerlist_greet"
            android:textColor="@color/partnerlist_button_text"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/nameRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
