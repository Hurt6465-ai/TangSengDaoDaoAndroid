<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/partnerlist_card_base"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:rippleColor="@color/partnerlist_card_ripple"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_partnerlist_card_mint"
        android:minHeight="136dp"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="12dp"
        android:paddingBottom="13dp">

        <!-- 只用一层低透明高光，卡片有质感但不会显得花哨。 -->
        <View
            android:id="@+id/cardGlow"
            android:layout_width="154dp"
            android:layout_height="154dp"
            android:layout_marginTop="-70dp"
            android:layout_marginEnd="-42dp"
            android:background="@drawable/bg_partnerlist_card_glow"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 渐变外圈 -> 留白层 -> 头像，避免头像和光环粘在一起。 -->
        <View
            android:id="@+id/avatarRing"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/bg_partnerlist_avatar_ring"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/avatarGap"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_partnerlist_avatar_gap"
            app:layout_constraintBottom_toBottomOf="@id/avatarRing"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/avatarIv"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:contentDescription="@string/partnerlist_avatar"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@id/avatarRing"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/flagIv"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:background="@drawable/bg_partnerlist_flag"
            android:elevation="3dp"
            android:padding="1.5dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing" />

        <View
            android:id="@+id/onlineDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_partnerlist_online"
            android:elevation="3dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <TextView
            android:id="@+id/activeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_partnerlist_active_pill"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:minHeight="20dp"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/partnerlist_active_text"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toBottomOf="@id/avatarRing" />

        <LinearLayout
            android:id="@+id/nameRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:minHeight="25dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/greetingBtn"
            app:layout_constraintStart_toEndOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing">

            <TextView
                android:id="@+id/nameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="@color/partnerlist_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/freshBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_partnerlist_new_badge"
                android:includeFontPadding="true"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/partnerlist_new_recommendation"
                android:textColor="@color/partnerlist_badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/newBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_partnerlist_new_badge"
                android:includeFontPadding="true"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/partnerlist_new"
                android:textColor="@color/partnerlist_badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/languageTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_partnerlist_language_chip"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:textColor="@color/partnerlist_accent_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/nameRow"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/nameRow"
            app:layout_constraintTop_toBottomOf="@id/nameRow" />

        <TextView
            android:id="@+id/introTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/partnerlist_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/nameRow"
            app:layout_constraintStart_toStartOf="@id/nameRow"
            app:layout_constraintTop_toBottomOf="@id/languageTv" />

        <TextView
            android:id="@+id/greetingBtn"
            android:layout_width="78dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_partnerlist_greeting"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="@string/partnerlist_greet"
            android:textColor="@color/partnerlist_button_text"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
