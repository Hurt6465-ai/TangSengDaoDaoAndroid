<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="7dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/partnerlist_card_base"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false"
    app:rippleColor="@color/partnerlist_card_ripple"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardSurface"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_partnerlist_card_mint"
        android:minHeight="136dp"
        android:paddingStart="14dp"
        android:paddingTop="13dp"
        android:paddingEnd="12dp"
        android:paddingBottom="13dp">

        <!-- 在线时才显示：2dp 渐变光环 + 1dp 极细留白。 -->
        <View
            android:id="@+id/avatarRing"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/bg_partnerlist_avatar_ring_mint_sky"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/avatarGap"
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:background="@drawable/bg_partnerlist_avatar_gap"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/avatarRing"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <!-- 与会话列表、全屏语伴共用 AvatarView：国旗嵌入头像时会自动挖出极细间隙。 -->
        <com.chat.base.ui.components.AvatarView
            android:id="@+id/avatarView"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/partnerlist_avatar"
            app:layout_constraintBottom_toBottomOf="@id/avatarRing"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <View
            android:id="@+id/onlineDot"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_partnerlist_online"
            android:elevation="2dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing" />

        <!-- 只显示“在线”或“几分钟前在线”，超过一小时直接隐藏。 -->
        <TextView
            android:id="@+id/activeTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:maxWidth="88dp"
            android:textColor="@color/partnerlist_active_text"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/avatarRing"
            app:layout_constraintStart_toStartOf="@id/avatarRing"
            app:layout_constraintTop_toBottomOf="@id/avatarRing" />

        <LinearLayout
            android:id="@+id/nameRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="13dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="9dp"
            android:gravity="center_vertical"
            android:minHeight="25dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/greetingBtn"
            app:layout_constraintStart_toEndOf="@id/avatarRing"
            app:layout_constraintTop_toTopOf="@id/avatarRing">

            <TextView
                android:id="@+id/nameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:textColor="@color/partnerlist_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/freshBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_partnerlist_new_badge"
                android:includeFontPadding="true"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/partnerlist_new_recommendation"
                android:textColor="@color/partnerlist_badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/newBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_partnerlist_new_badge"
                android:includeFontPadding="true"
                android:paddingStart="7dp"
                android:paddingTop="2dp"
                android:paddingEnd="7dp"
                android:paddingBottom="2dp"
                android:text="@string/partnerlist_new"
                android:textColor="@color/partnerlist_badge_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 母语与学习语言拆成两个独立浅色气囊，中间只保留轻量交换符号。 -->
        <LinearLayout
            android:id="@+id/languageRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/nameRow"
            app:layout_constraintStart_toStartOf="@id/nameRow"
            app:layout_constraintTop_toBottomOf="@id/nameRow">

            <TextView
                android:id="@+id/nativeLanguageTv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_partnerlist_language_native"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="52dp"
                android:minWidth="30dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/partnerlist_native_language_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/languageExchangeTv"
                android:layout_width="18dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⇋"
                android:textColor="@color/partnerlist_language_exchange"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/learningLanguageTv"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:background="@drawable/bg_partnerlist_language_learning"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:maxWidth="52dp"
                android:minWidth="30dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/partnerlist_learning_language_text"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/introTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="4dp"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:textColor="@color/partnerlist_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/nameRow"
            app:layout_constraintTop_toBottomOf="@id/languageRow"
            app:layout_goneMarginTop="5dp" />

        <!-- 左尾气泡式 Hi：浅蓝气泡、粉红字，保持轻量且不抢头像。 -->
        <TextView
            android:id="@+id/greetingBtn"
            android:layout_width="66dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_partnerlist_greeting"
            android:clickable="true"
            android:elevation="0dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="9dp"
            android:paddingEnd="3dp"
            android:paddingBottom="1dp"
            android:text="@string/partnerlist_greet"
            android:textColor="@color/partnerlist_button_text"
            android:textSize="17sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.13" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
