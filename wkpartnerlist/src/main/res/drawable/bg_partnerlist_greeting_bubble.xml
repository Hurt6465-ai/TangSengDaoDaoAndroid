        android:fillColor="#52FFFFFF"
        android:pathData="M18,6 H53 C59.3,6 63.8,9.6 66,14.8 C61.8,11.6 57.8,10.3 52,10.3 H18 C12.7,10.3 8.8,12.3 6.5,15.4 C8,9.8 12.2,6 18,6 Z" />
