<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft pink-violet floor shadow. No tail, no highlight, no heavy outline. -->
    <item
        android:left="5dp"
        android:top="9dp"
        android:right="5dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#18C85C91" />
        </shape>
    </item>

    <item
        android:left="3dp"
        android:top="6dp"
        android:right="3dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <solid android:color="#12A77DD5" />
        </shape>
    </item>

    <!-- Main air-cushion body: white, rounded, fine edge, floating on the pastel card. -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFFFFFFF" />
            <stroke
                android:width="0.8dp"
                android:color="#FFF1D8E5" />
            <padding
                android:left="0dp"
                android:top="0dp"
                android:right="0dp"
                android:bottom="0dp" />
        </shape>
    </item>
</layer-list>
