<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#257D8CFF" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="#6A7D8CFF" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="#1B7D8CFF" android:endColor="#1B9A82F6" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="#5C8591FF" />
        </shape>
    </item>
</selector>
