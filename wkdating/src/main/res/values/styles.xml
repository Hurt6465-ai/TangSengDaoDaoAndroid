<?xml version='1.0' encoding='UTF-8'?>
<resources>
    <style name="WkDatingSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:textColor">#202026</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WkDatingSectionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">#52525B</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WkDatingQuotaPill">
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_dating_quota_pill</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#51515B</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WkDatingMenuRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="WkDatingMenuIcon">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#53535B</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WkDatingMenuTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">#26262C</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="WkDatingMenuArrow">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:background">@drawable/ic_dating_chevron_right</item>
    </style>

    <style name="WkDatingDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">60dp</item>
        <item name="android:background">#ECECEF</item>
    </style>

    <!-- 资料详情页专用别名。activity_wk_dating_profile_detail.xml 使用这两个名称。 -->
    <style name="WkDatingDetailTitle" parent="WkDatingSectionTitle">
        <item name="android:layout_marginTop">18dp</item>
    </style>

    <style name="WkDatingDetailBody" parent="WkDatingSectionBody">
        <item name="android:layout_marginTop">7dp</item>
    </style>

</resources>
