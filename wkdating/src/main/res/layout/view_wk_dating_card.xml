<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:background="@drawable/bg_dating_card_round"
    android:clipChildren="true"
    android:clipToOutline="true"
    android:clipToPadding="true">

    <ImageView
        android:id="@+id/photoIv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#111111"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_dating_top_soft_mask" />

    <LinearLayout
        android:id="@+id/indicatorRow"
        android:layout_width="54dp"
        android:layout_height="3dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="92dp"
        android:gravity="center"
        android:orientation="horizontal" />

    <ImageView
        android:id="@+id/left_overlay"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="126dp"
        android:layout_marginEnd="24dp"
        android:alpha="0"
        android:contentDescription="@string/dating_dislike"
        android:rotation="10"
        android:src="@drawable/ic_dating_broken_heart_gray" />

    <TextView
        android:id="@+id/right_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="126dp"
        android:alpha="0"
        android:rotation="-13"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:text="@string/dating_swipe_stamp_like"
        android:textColor="#FFFF426D"
        android:textSize="31sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/top_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="138dp"
        android:alpha="0"
        android:shadowColor="#99000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:text="@string/dating_swipe_stamp_favorite"
        android:textColor="#FF75A8FF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <View android:id="@+id/bottom_overlay" android:layout_width="1dp" android:layout_height="1dp" android:alpha="0" />

    <ImageView
        android:id="@+id/profileArrowBtn"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="138dp"
        android:background="@drawable/bg_dating_profile_arrow"
        android:contentDescription="@string/dating_view_more"
        android:padding="8dp"
        android:src="@drawable/ic_dating_chevron_up"
        android:tint="#FFFFFFFF" />

    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="68dp"
        android:paddingEnd="62dp"
        android:paddingBottom="106dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/avatarView"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#C0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="9"
                    android:textColor="#FFFFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/locationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/locationIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_dating_location"
                        android:tint="#F3FFFFFF" />

                    <TextView
                        android:id="@+id/metaTv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#B0000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="7"
                        android:textColor="#F3FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/jobTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#AA000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="#E9FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/introTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:shadowColor="#C0000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="#F8FFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/tagRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal" />
    </LinearLayout>
</FrameLayout>
