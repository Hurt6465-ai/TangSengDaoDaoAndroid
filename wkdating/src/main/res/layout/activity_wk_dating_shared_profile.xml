<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F9"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_dating_top_icon_button"
            android:contentDescription="@string/dating_back"
            android:elevation="2dp"
            android:padding="9dp"
            android:src="@drawable/ic_dating_back"
            android:tint="#24242A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/dating_shared_editor_title"
            android:textColor="#16181E"
            android:textSize="19sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dating_detail_info_row"
                android:lineSpacingExtra="3dp"
                android:padding="14dp"
                android:text="@string/dating_shared_editor_tip"
                android:textColor="#656B76"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dating_shared_core_title"
                    android:textColor="#202026"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/nameEt"
                    style="@style/WkDatingEditText"
                    android:layout_marginTop="10dp"
                    android:hint="@string/dating_shared_name"
                    android:maxLength="40"
                    android:singleLine="true" />

                <LinearLayout android:id="@+id/birthdayRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_birthday" />
                    <TextView android:id="@+id/birthdayValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/genderRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_gender" />
                    <TextView android:id="@+id/genderValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/countryRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_country" />
                    <TextView android:id="@+id/countryValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/nativeLanguagesRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_native_languages" />
                    <TextView android:id="@+id/nativeLanguagesValue" style="@style/WkDatingEditValue" android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/learningLanguagesRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_learning_languages" />
                    <TextView android:id="@+id/learningLanguagesValue" style="@style/WkDatingEditValue" android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dating_shared_partner_default_title"
                    android:textColor="#202026"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/dating_shared_partner_default_note"
                    android:textColor="#9298A3"
                    android:textSize="12sp" />

                <LinearLayout android:id="@+id/relationshipRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_relationship_label" />
                    <TextView android:id="@+id/relationshipValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/personalityRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_personality_label" />
                    <TextView android:id="@+id/personalityValue" style="@style/WkDatingEditValue" android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/petsRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_pets" />
                    <TextView android:id="@+id/petsValue" style="@style/WkDatingEditValue" android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/sportsRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_sports" />
                    <TextView android:id="@+id/sportsValue" style="@style/WkDatingEditValue" android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/moviesRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_movies" />
                    <TextView android:id="@+id/moviesValue" style="@style/WkDatingEditValue" android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/jobRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_job" />
                    <TextView android:id="@+id/jobValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/educationRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_shared_education" />
                    <TextView android:id="@+id/educationValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_dating_loading_button"
            android:gravity="center"
            android:text="@string/dating_save_shared_profile"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
