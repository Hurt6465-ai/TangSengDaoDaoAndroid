<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/dating_back"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_dating_back"
            android:tint="#202026" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/dating_edit_profile_title"
            android:textColor="#18181D"
            android:textSize="20sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="#F2F2F4"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/editTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/dating_edit_tab"
            android:textColor="#18181D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="36dp"
            android:background="#D9D9DE" />

        <TextView
            android:id="@+id/previewTab"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/dating_preview_tab"
            android:textColor="#66666F"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dating_my_photos"
                    android:textColor="#202026"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/profileScoreTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#D91C28"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/photoTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#777780"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/photoRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <TextView
                style="@style/WkDatingSettingsSectionTitle"
                android:text="@string/dating_basic_info_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="15dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/sharedSummaryTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#4C5059"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/sharedEditBtn"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dating_detail_info_row"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dating_edit_shared_profile_inside"
                        android:textColor="#2E3037"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_dating_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/WkDatingSettingsSectionTitle"
                android:text="@string/dating_preferences_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/intentRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_intent" />
                    <TextView android:id="@+id/intentValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingEditDivider" />

                <LinearLayout android:id="@+id/genderRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_gender" />
                    <TextView android:id="@+id/genderValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingEditDivider" />

                <LinearLayout android:id="@+id/ageRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_age" />
                    <TextView android:id="@+id/ageValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingEditDivider" />

                <LinearLayout android:id="@+id/sexualOrientationRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_orientation" />
                    <TextView android:id="@+id/sexualOrientationValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingEditDivider" />

                <LinearLayout android:id="@+id/dealbreakersRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_dealbreakers" />
                    <TextView
                        android:id="@+id/dealbreakersValue"
                        style="@style/WkDatingEditValue"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="210dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/WkDatingSettingsSectionTitle"
                android:text="@string/dating_lifestyle_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/drinkingRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_drinking" />
                    <TextView android:id="@+id/drinkingValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingEditDivider" />

                <LinearLayout android:id="@+id/smokingRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_smoking" />
                    <TextView android:id="@+id/smokingValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/WkDatingSettingsSectionTitle"
                android:text="@string/dating_about_me_section" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView style="@style/WkDatingEditFieldLabel" android:text="@string/dating_field_city" />
                <EditText
                    android:id="@+id/cityEt"
                    style="@style/WkDatingEditText"
                    android:hint="@string/dating_city" />

                <TextView style="@style/WkDatingEditFieldLabel" android:text="@string/dating_field_height" />
                <EditText
                    android:id="@+id/heightEt"
                    style="@style/WkDatingEditText"
                    android:hint="@string/dating_height_hint"
                    android:inputType="number" />

                <TextView style="@style/WkDatingEditFieldLabel" android:text="@string/dating_field_weight" />
                <EditText
                    android:id="@+id/weightEt"
                    style="@style/WkDatingEditText"
                    android:hint="@string/dating_weight_hint"
                    android:inputType="number" />

                <TextView style="@style/WkDatingEditFieldLabel" android:text="@string/dating_field_intro" />
                <EditText
                    android:id="@+id/introEt"
                    style="@style/WkDatingEditText"
                    android:layout_height="100dp"
                    android:gravity="top"
                    android:hint="@string/dating_about_hint"
                    android:inputType="textMultiLine"
                    android:maxLength="500" />

                <TextView style="@style/WkDatingEditFieldLabel" android:text="@string/dating_field_ideal" />
                <EditText
                    android:id="@+id/idealPartnerEt"
                    style="@style/WkDatingEditText"
                    android:layout_height="88dp"
                    android:gravity="top"
                    android:hint="@string/dating_ideal_hint"
                    android:inputType="textMultiLine"
                    android:maxLength="200" />

                <TextView style="@style/WkDatingEditFieldLabel" android:text="@string/dating_field_tags" />
                <EditText
                    android:id="@+id/tagsEt"
                    style="@style/WkDatingEditText"
                    android:layout_height="72dp"
                    android:gravity="top"
                    android:hint="@string/dating_tags_hint"
                    android:inputType="textMultiLine" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="#F2F2F4"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_dating_loading_button"
            android:gravity="center"
            android:text="@string/dating_save_profile"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/uploadOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/uploadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/uploadText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
