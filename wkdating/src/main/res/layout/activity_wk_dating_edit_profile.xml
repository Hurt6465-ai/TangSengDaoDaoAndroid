<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F7F7F9" android:orientation="vertical">
    <FrameLayout android:layout_width="match_parent" android:layout_height="58dp">
        <TextView android:id="@+id/backBtn" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:gravity="center" android:text="←" android:textColor="#16181E" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/dating_edit_profile_title" android:textColor="#16181E" android:textSize="18sp" android:textStyle="bold" />
    </FrameLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FFFFFFFF" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dating_my_photos" android:textColor="#16181E" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/photoTip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#6C7380" android:textSize="12sp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/photoRecycler" android:layout_width="match_parent" android:layout_height="228dp" android:layout_marginTop="10dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:overScrollMode="never" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#FFFFFFFF" android:orientation="vertical" android:padding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_shared_profile" android:textColor="#16181E" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/sharedEditBtn" android:layout_width="wrap_content" android:layout_height="36dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/dating_edit_shared_profile" android:textColor="#FF4F6D" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/dating_shared_profile_tip" android:textColor="#8A909B" android:textSize="12sp" />
                <TextView android:id="@+id/sharedBasicTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#343740" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:id="@+id/sharedRelationshipTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#555B66" android:textSize="13sp" />
                <TextView android:id="@+id/sharedPersonalityTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#555B66" android:textSize="13sp" />
                <TextView android:id="@+id/sharedInterestTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="3dp" android:textColor="#555B66" android:textSize="13sp" />
                <TextView android:id="@+id/sharedCareerTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#555B66" android:textSize="13sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#FFFFFFFF" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp">
                <LinearLayout android:id="@+id/intentRow" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_edit_intent" android:textColor="#16181E" android:textSize="15sp" />
                    <TextView android:id="@+id/intentValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxWidth="220dp" android:maxLines="1" android:textColor="#6C7380" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <LinearLayout android:id="@+id/genderRow" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_edit_gender" android:textColor="#16181E" android:textSize="15sp" />
                    <TextView android:id="@+id/genderValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7380" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <LinearLayout android:id="@+id/ageRow" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_edit_age" android:textColor="#16181E" android:textSize="15sp" />
                    <TextView android:id="@+id/ageValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7380" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <LinearLayout android:id="@+id/sexualOrientationRow" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_edit_orientation" android:textColor="#16181E" android:textSize="15sp" />
                    <TextView android:id="@+id/sexualOrientationValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7380" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <LinearLayout android:id="@+id/drinkingRow" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_edit_drinking" android:textColor="#16181E" android:textSize="15sp" />
                    <TextView android:id="@+id/drinkingValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7380" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <LinearLayout android:id="@+id/smokingRow" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_edit_smoking" android:textColor="#16181E" android:textSize="15sp" />
                    <TextView android:id="@+id/smokingValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#6C7380" android:textSize="14sp" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <LinearLayout android:id="@+id/dealbreakersRow" android:layout_width="match_parent" android:layout_height="54dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/dating_edit_dealbreakers" android:textColor="#16181E" android:textSize="15sp" />
                    <TextView android:id="@+id/dealbreakersValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxWidth="220dp" android:maxLines="1" android:textColor="#6C7380" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#FFFFFFFF" android:orientation="vertical" android:padding="14dp">
                <EditText android:id="@+id/cityEt" android:layout_width="match_parent" android:layout_height="48dp" android:background="#00000000" android:hint="@string/dating_city" android:textColor="#16181E" android:textColorHint="#9AA1AE" android:textSize="15sp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <EditText android:id="@+id/heightEt" android:layout_width="match_parent" android:layout_height="48dp" android:background="#00000000" android:hint="@string/dating_height_hint" android:inputType="number" android:textColor="#16181E" android:textColorHint="#9AA1AE" android:textSize="15sp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEF0F4" />
                <EditText android:id="@+id/weightEt" android:layout_width="match_parent" android:layout_height="48dp" android:background="#00000000" android:hint="@string/dating_weight_hint" android:inputType="number" android:textColor="#16181E" android:textColorHint="#9AA1AE" android:textSize="15sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#FFFFFFFF" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dating_section_about" android:textColor="#16181E" android:textSize="15sp" android:textStyle="bold" />
                <EditText android:id="@+id/bioEt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#00000000" android:gravity="top" android:hint="@string/dating_about_hint" android:inputType="textMultiLine" android:lines="4" android:maxLength="500" android:maxLines="6" android:textColor="#16181E" android:textColorHint="#9AA1AE" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#FFFFFFFF" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dating_section_ideal" android:textColor="#16181E" android:textSize="15sp" android:textStyle="bold" />
                <EditText android:id="@+id/idealPartnerEt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#00000000" android:gravity="top" android:hint="@string/dating_ideal_hint" android:inputType="textMultiLine" android:lines="3" android:maxLength="200" android:maxLines="4" android:textColor="#16181E" android:textColorHint="#9AA1AE" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="#FFFFFFFF" android:orientation="vertical" android:padding="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dating_edit_tags" android:textColor="#16181E" android:textSize="15sp" android:textStyle="bold" />
                <EditText android:id="@+id/tagsEt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="#00000000" android:hint="@string/dating_tags_hint" android:inputType="textMultiLine" android:lines="2" android:textColor="#16181E" android:textColorHint="#9AA1AE" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <FrameLayout android:layout_width="match_parent" android:layout_height="68dp" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/saveBtn" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_dating_loading_button" android:gravity="center" android:text="@string/dating_save_profile" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
    </FrameLayout>
    <LinearLayout android:id="@+id/uploadOverlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#80000000" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <ProgressBar android:id="@+id/uploadProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="220dp" android:layout_height="wrap_content" android:max="100" />
        <TextView android:id="@+id/uploadText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="#FFFFFFFF" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>