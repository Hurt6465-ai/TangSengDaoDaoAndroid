<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F9"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/bg_dating_top_icon_button"
            android:contentDescription="@string/dating_back"
            android:elevation="2dp"
            android:padding="9dp"
            android:src="@drawable/ic_dating_back"
            android:tint="#24242A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/dating_edit_profile_title"
            android:textColor="#16181E"
            android:textSize="19sp"
            android:textStyle="bold" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dating_my_photos"
                    android:textColor="#16181E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/photoTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#6C7380"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/photoRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dating_detail_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dating_status_title"
                        android:textColor="#202026"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/dating_status_edit_tip"
                        android:textColor="#8A909B"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusActionBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_dating_status_pill"
                    android:gravity="center"
                    android:minWidth="92dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FF4F6D"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dating_shared_profile"
                    android:textColor="#16181E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/dating_shared_profile_partner_tip"
                    android:textColor="#8A909B"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/sharedSummaryTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="#4C5059"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/sharedEditBtn"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_dating_detail_info_row"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dating_edit_shared_profile_inside"
                        android:textColor="#2E3037"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_dating_chevron_right" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/intentRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_intent" />
                    <TextView android:id="@+id/intentValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/genderRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_gender" />
                    <TextView android:id="@+id/genderValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/ageRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_age" />
                    <TextView android:id="@+id/ageValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/sexualOrientationRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_orientation" />
                    <TextView android:id="@+id/sexualOrientationValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/drinkingRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_drinking" />
                    <TextView android:id="@+id/drinkingValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/smokingRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_smoking" />
                    <TextView android:id="@+id/smokingValue" style="@style/WkDatingEditValue" />
                </LinearLayout>
                <View style="@style/WkDatingDivider" />
                <LinearLayout android:id="@+id/dealbreakersRow" style="@style/WkDatingEditRow">
                    <TextView style="@style/WkDatingEditLabel" android:text="@string/dating_edit_dealbreakers" />
                    <TextView android:id="@+id/dealbreakersValue" style="@style/WkDatingEditValue" android:maxWidth="210dp" android:ellipsize="end" android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:padding="14dp">

                <EditText android:id="@+id/cityEt" style="@style/WkDatingEditText" android:hint="@string/dating_city" />
                <EditText android:id="@+id/heightEt" style="@style/WkDatingEditText" android:hint="@string/dating_height_hint" android:inputType="number" />
                <EditText android:id="@+id/weightEt" style="@style/WkDatingEditText" android:hint="@string/dating_weight_hint" android:inputType="number" />
                <EditText android:id="@+id/introEt" style="@style/WkDatingEditText" android:layout_height="96dp" android:gravity="top" android:hint="@string/dating_about_hint" android:inputType="textMultiLine" android:maxLength="500" />
                <EditText android:id="@+id/idealPartnerEt" style="@style/WkDatingEditText" android:layout_height="86dp" android:gravity="top" android:hint="@string/dating_ideal_hint" android:inputType="textMultiLine" android:maxLength="200" />
                <EditText android:id="@+id/tagsEt" style="@style/WkDatingEditText" android:layout_height="70dp" android:gravity="top" android:hint="@string/dating_tags_hint" android:inputType="textMultiLine" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/saveBtn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_dating_loading_button"
            android:gravity="center"
            android:text="@string/dating_save_profile"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/uploadOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/uploadProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/uploadText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
