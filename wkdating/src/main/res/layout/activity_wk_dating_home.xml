<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.chat.dating.DatingSwipeDeckView
        android:id="@+id/deckView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_gravity="top"
        android:paddingStart="18dp"
        android:paddingTop="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/filterBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|top"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="☷"
            android:textColor="#F2FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/scopeTabs"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_gravity="top|center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recommendTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="72dp"
                android:text="推荐"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nearbyTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="18dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="72dp"
                android:text="附近"
                android:textColor="#AAFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="106dp"
        android:layout_gravity="bottom"
        android:gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="7dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/passBtn"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_dating_action_pass"
            android:elevation="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="×"
            android:textColor="#FFFF4F6A"
            android:textSize="42sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="18dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/favoriteBtn"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_dating_action_favorite"
            android:elevation="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="★"
            android:textColor="#FF77A7FF"
            android:textSize="29sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="18dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/likeBtn"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_dating_action_like"
            android:elevation="16dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="♥"
            android:textColor="#FFFFFFFF"
            android:textSize="42sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/loadingTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dating_loading"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/retryBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dating_loading_button"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/dating_retry"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
