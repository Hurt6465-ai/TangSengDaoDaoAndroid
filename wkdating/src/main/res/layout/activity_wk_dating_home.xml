<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dating_screen"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-70dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.35"
        android:background="@drawable/bg_dating_action_like" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-70dp"
        android:layout_marginBottom="40dp"
        android:alpha="0.28"
        android:background="@drawable/bg_dating_action_like" />

    <com.chat.dating.DatingSwipeDeckView
        android:id="@+id/deckView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="94dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="30dp"
        android:paddingEnd="14dp"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/backBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_dating_filter_button"
            android:elevation="4dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#D8325570"
            android:textSize="31sp" />

        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dating_segment_container"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/recommendTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/dating_tab_recommend"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nearbyTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/dating_tab_nearby"
                android:textColor="#7A35425A"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/filterBtn"
            android:layout_width="58dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_dating_filter_button"
            android:elevation="4dp"
            android:gravity="center"
            android:text="@string/dating_filter"
            android:textColor="#D8325570"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/filterSummaryTv"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="86dp"
        android:background="@drawable/bg_dating_filter_button"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#9F35425A"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:layout_gravity="bottom"
        android:gravity="top|center_horizontal"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/passBtn"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_dating_action_pass"
            android:elevation="14dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFF4F6A"
            android:textSize="36sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="44dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/likeBtn"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:background="@drawable/bg_dating_action_like"
            android:elevation="16dp"
            android:gravity="center"
            android:text="♥"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dating_loading_panel"
            android:elevation="10dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:id="@+id/loadingTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/dating_loading"
                android:textColor="#D8325570"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/retryBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_dating_loading_button"
                android:gravity="center"
                android:text="@string/dating_retry"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
