<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.yuyakaido.android.cardstackview.CardStackView
        android:id="@+id/deckView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <com.chat.dating.DatingSwipeFxView
        android:id="@+id/swipeFxView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:clickable="false"
        android:focusable="false" />

    <!-- 与聊天首页一致：状态栏安全区 + 单行 56dp 标签，不再叠加第二行推荐/附近/筛选。 -->
    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_dating_top_soft_mask"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/modeTabs"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/partnerModeTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="62dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="@string/dating_mode_partner"
                android:textColor="#A8FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/datingModeTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="62dp"
                android:paddingStart="3dp"
                android:paddingEnd="3dp"
                android:text="@string/dating_mode_dating"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 个人主页只在交友页出现，并与“语伴/交友”处于同一行。 -->
        <ImageView
            android:id="@+id/mineBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/dating_mine_title"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:src="@drawable/ic_dating_mine"
            android:tint="#FFFFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="72dp"
        android:background="@drawable/bg_dating_action_dock"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rewindBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_dating_action_rewind"
            android:contentDescription="@string/dating_rewind"
            android:elevation="12dp"
            android:padding="10dp"
            android:src="@drawable/ic_dating_rewind_thick" />

        <Space android:layout_width="13dp" android:layout_height="1dp" />

        <ImageView
            android:id="@+id/passBtn"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_dating_action_pass"
            android:contentDescription="@string/dating_pass"
            android:elevation="14dp"
            android:padding="17dp"
            android:src="@drawable/ic_dating_close" />

        <Space android:layout_width="13dp" android:layout_height="1dp" />

        <ImageView
            android:id="@+id/favoriteBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_dating_action_favorite"
            android:contentDescription="@string/dating_favorites_title"
            android:elevation="14dp"
            android:padding="14dp"
            android:src="@drawable/ic_dating_star" />

        <Space android:layout_width="13dp" android:layout_height="1dp" />

        <ImageView
            android:id="@+id/likeBtn"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_dating_action_like"
            android:contentDescription="@string/dating_like"
            android:elevation="16dp"
            android:padding="17dp"
            android:src="@drawable/ic_dating_heart" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/tab_bg"
        app:itemIconTint="@color/transparent"
        app:menu="@menu/menu_navigation" />

    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/loadingTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dating_loading"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/retryBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dating_loading_button"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/dating_retry"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
