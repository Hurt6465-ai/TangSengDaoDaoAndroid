<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <com.yuyakaido.android.cardstackview.CardStackView
        android:id="@+id/deckView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <com.chat.dating.DatingSwipeFxView
        android:id="@+id/swipeFxView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:clickable="false"
        android:focusable="false" />

    <FrameLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_dating_top_soft_mask"
        android:paddingStart="14dp"
        android:paddingTop="0dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/modeTabs"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/partnerModeTab"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/dating_mode_partner"
                android:textColor="#A8FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="36dp">

                <TextView
                    android:id="@+id/datingModeTab"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/dating_mode_dating"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="22dp"
                    android:layout_height="3dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:background="#FFFFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/filterBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|top"
            android:layout_marginTop="34dp"
            android:foreground="?android:attr/selectableItemBackgroundBorderless">

            <View
                android:layout_width="26dp"
                android:layout_height="2dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_dating_filter_line" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="9dp"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_dating_filter_knob" />

            <View
                android:layout_width="26dp"
                android:layout_height="2dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="29dp"
                android:background="@drawable/bg_dating_filter_line" />

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="27dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_dating_filter_knob" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/scopeTabs"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="34dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/recommendTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="70dp"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="@string/dating_tab_recommend"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nearbyTab"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="70dp"
                android:shadowColor="#90000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="@string/dating_tab_nearby"
                android:textColor="#88FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- “我的”只保留无背景的人形图标，避免像一个编辑按钮。 -->
        <ImageView
            android:id="@+id/mineBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="34dp"
            android:contentDescription="@string/dating_mine_title"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_dating_mine"
            android:tint="#FFFFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/rewindBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_dating_action_rewind"
            android:contentDescription="@string/dating_rewind"
            android:elevation="12dp"
            android:padding="10dp"
            android:src="@drawable/ic_dating_rewind_thick" />

        <Space android:layout_width="13dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/passBtn"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_dating_action_pass"
            android:elevation="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="×"
            android:textColor="#FFFF4F6A"
            android:textSize="42sp"
            android:textStyle="bold" />

        <Space android:layout_width="13dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/favoriteBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_dating_action_favorite"
            android:elevation="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="★"
            android:textColor="#FF68A2FF"
            android:textSize="29sp"
            android:textStyle="bold" />

        <Space android:layout_width="13dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/likeBtn"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_dating_action_like"
            android:elevation="16dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="♥"
            android:textColor="#FFFF426D"
            android:textSize="41sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@color/tab_bg"
        app:itemIconTint="@color/transparent"
        app:menu="@menu/menu_navigation" />

    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:background="#000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="30dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/loadingTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dating_loading"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/retryBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dating_loading_button"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/dating_retry"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
