<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F2F5">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="520dp">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/photoPager"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/photoCountTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="26dp"
                    android:background="@drawable/bg_dating_photo_count"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="1/1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-22dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_dating_detail_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FF202026"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/locationTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FF767681"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/aboutTitle"
                    style="@style/WkDatingDetailTitle"
                    android:text="关于我" />

                <TextView
                    android:id="@+id/aboutTv"
                    style="@style/WkDatingDetailBody" />

                <TextView
                    android:id="@+id/loveTitle"
                    style="@style/WkDatingDetailTitle"
                    android:text="恋爱期待" />

                <TextView
                    android:id="@+id/loveTv"
                    style="@style/WkDatingDetailBody" />

                <TextView
                    android:id="@+id/idealTitle"
                    style="@style/WkDatingDetailTitle"
                    android:text="希望对方" />

                <TextView
                    android:id="@+id/idealTv"
                    style="@style/WkDatingDetailBody" />

                <TextView
                    android:id="@+id/dealbreakersTitle"
                    style="@style/WkDatingDetailTitle"
                    android:text="我反感" />

                <TextView
                    android:id="@+id/dealbreakersTv"
                    style="@style/WkDatingDetailBody" />

                <TextView
                    android:id="@+id/basicTitle"
                    style="@style/WkDatingDetailTitle"
                    android:text="基本资料" />

                <TextView
                    android:id="@+id/basicTv"
                    style="@style/WkDatingDetailBody" />

                <TextView
                    android:id="@+id/tagsTitle"
                    style="@style/WkDatingDetailTitle"
                    android:text="兴趣与性格" />

                <com.chat.dating.DatingFlowLayout
                    android:id="@+id/tagsLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="#FFEDEDF0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/blockBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="屏蔽"
                        android:textColor="#FF8C8C95"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:background="#FFE2E2E7" />

                    <TextView
                        android:id="@+id/reportBtn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="举报"
                        android:textColor="#FFFF526C"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_dating_detail_bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/passBtn"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bg_dating_detail_action_pass"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="×"
            android:textColor="#FFFF4F6A"
            android:textSize="41sp"
            android:textStyle="bold" />

        <Space android:layout_width="22dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/favoriteBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_dating_detail_action_favorite"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="★"
            android:textColor="#FF68A2FF"
            android:textSize="29sp"
            android:textStyle="bold" />

        <Space android:layout_width="22dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/likeBtn"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/bg_dating_detail_action_like"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="♥"
            android:textColor="#FFFF426D"
            android:textSize="40sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
