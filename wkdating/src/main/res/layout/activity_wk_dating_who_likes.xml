<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F6F8">

    <ImageView
        android:id="@+id/backBtn"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:contentDescription="返回"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"
        android:padding="13dp"
        android:src="@drawable/ic_dating_back"
        android:tint="#24242A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_dating_likers_blur"
            android:gravity="center"
            android:text="♥"
            android:textColor="#FFFF496C"
            android:textSize="52sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="看看谁对你心动"
            android:textColor="#202026"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="免费用户只显示人数与模糊预览。开通会员后可查看完整列表；双方喜欢后才可以聊天。"
            android:textColor="#777780"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/actionBtn"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dating_primary_button"
            android:gravity="center"
            android:text="了解会员权益"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
