<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F6F6F8" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="32dp">
        <FrameLayout android:layout_width="match_parent" android:layout_height="64dp" android:paddingStart="8dp" android:paddingEnd="18dp">
            <ImageView android:id="@+id/backBtn" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="start|center_vertical" android:contentDescription="@string/dating_back" android:foreground="?android:attr/selectableItemBackgroundBorderless" android:padding="13dp" android:src="@drawable/ic_dating_back" android:tint="#24242A" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="@string/dating_mine_title" android:textColor="#202026" android:textSize="20sp" android:textStyle="bold" />
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_dating_detail_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
            <FrameLayout android:layout_width="74dp" android:layout_height="74dp">
                <com.chat.base.ui.components.AvatarView android:id="@+id/avatarView" android:layout_width="74dp" android:layout_height="74dp" android:clipChildren="false" android:clipToPadding="false" />
            </FrameLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/nameTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#202026" android:textSize="20sp" android:textStyle="bold" />
                <TextView android:id="@+id/metaTv" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#777780" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="14dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_dating_detail_card" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="14dp" android:paddingEnd="16dp" android:paddingBottom="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dating_daily_quota" android:textColor="#202026" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
                <TextView android:id="@+id/likeQuotaTv" style="@style/WkDatingQuotaPill" android:layout_width="0dp" android:layout_weight="1" />
                <TextView android:id="@+id/favoriteQuotaTv" style="@style/WkDatingQuotaPill" android:layout_width="0dp" android:layout_marginStart="8dp" android:layout_weight="1" />
                <TextView android:id="@+id/rewindQuotaTv" style="@style/WkDatingQuotaPill" android:layout_width="0dp" android:layout_marginStart="8dp" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="14dp" android:layout_marginEnd="16dp" android:background="@drawable/bg_dating_detail_card" android:orientation="vertical">
            <LinearLayout android:id="@+id/statusRow" style="@style/WkDatingMenuRow">
                <TextView style="@style/WkDatingMenuIcon" android:text="◉" android:textColor="#FF4F6D" />
                <TextView style="@style/WkDatingMenuTitle" android:text="@string/dating_status_title" />
                <TextView android:id="@+id/statusValueTv" android:layout_width="wrap_content" android:layout_height="36dp" android:background="@drawable/bg_dating_status_pill" android:gravity="center" android:minWidth="72dp" android:paddingStart="11dp" android:paddingEnd="11dp" android:textColor="#FF4F6D" android:textSize="13sp" android:textStyle="bold" />
                <TextView style="@style/WkDatingMenuArrow" />
            </LinearLayout>
            <View style="@style/WkDatingDivider" />
            <LinearLayout android:id="@+id/editProfileRow" style="@style/WkDatingMenuRow">
                <TextView style="@style/WkDatingMenuIcon" android:text="✎" />
                <TextView style="@style/WkDatingMenuTitle" android:text="@string/dating_edit_profile_title" />
                <TextView style="@style/WkDatingMenuArrow" />
            </LinearLayout>
            <View style="@style/WkDatingDivider" />
            <LinearLayout android:id="@+id/favoritesRow" style="@style/WkDatingMenuRow">
                <TextView style="@style/WkDatingMenuIcon" android:text="★" android:textColor="#5C8FEF" />
                <TextView style="@style/WkDatingMenuTitle" android:text="@string/dating_favorites_title" />
                <TextView style="@style/WkDatingMenuArrow" />
            </LinearLayout>
            <View style="@style/WkDatingDivider" />
            <LinearLayout android:id="@+id/whoLikesRow" style="@style/WkDatingMenuRow">
                <TextView style="@style/WkDatingMenuIcon" android:text="♥" android:textColor="#FF496C" />
                <TextView style="@style/WkDatingMenuTitle" android:text="@string/dating_who_likes_me" />
                <TextView android:layout_width="wrap_content" android:layout_height="26dp" android:background="@drawable/bg_dating_member_badge" android:gravity="center" android:paddingStart="9dp" android:paddingEnd="9dp" android:text="@string/dating_membership" android:textColor="#8A5A17" android:textSize="11sp" android:textStyle="bold" />
                <TextView style="@style/WkDatingMenuArrow" />
            </LinearLayout>
            <View style="@style/WkDatingDivider" />
            <LinearLayout android:id="@+id/matchesRow" style="@style/WkDatingMenuRow">
                <TextView style="@style/WkDatingMenuIcon" android:text="●" android:textColor="#8C63E8" />
                <TextView style="@style/WkDatingMenuTitle" android:text="@string/dating_my_matches" />
                <TextView style="@style/WkDatingMenuArrow" />
            </LinearLayout>
            <View style="@style/WkDatingDivider" />
            <LinearLayout android:id="@+id/quotaRow" style="@style/WkDatingMenuRow">
                <TextView style="@style/WkDatingMenuIcon" android:text="⌁" />
                <TextView style="@style/WkDatingMenuTitle" android:text="@string/dating_quota_rules" />
                <TextView style="@style/WkDatingMenuArrow" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>