<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dating_match_dialog"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFF416C"
            android:textSize="28sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="126dp"
            android:layout_marginTop="22dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/myAvatar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="start|center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/targetAvatar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="end|center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/heartTv"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_dating_match_heart"
                android:gravity="center"
                android:text="♥"
                android:textColor="#FFFFFFFF"
                android:textSize="36sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/subtitleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="#FF65656E"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/chatBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_dating_primary_button"
            android:gravity="center"
            android:text="@string/dating_chat_now"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/keepBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/dating_keep_swiping"
            android:textColor="#FF8C8C95"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
