<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profile_page_bg"
    android:orientation="vertical">

    <include layout="@layout/wk_title_bar_layout" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:background="@drawable/profile_photo_bg"
                android:padding="4dp">

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/avatarView"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/coverIv"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/profile_photo_delete_bg"
                    android:padding="6dp"
                    android:src="@mipmap/ico_xiangji" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="22dp"
                android:text="@string/wklogin_upload_header"
                android:textColor="#ff777777"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/profile_card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wklogin_nickname"
                    android:textColor="@color/color999"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/nameEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:gravity="center"
                    android:hint="@string/must_input_name"
                    android:maxLength="20"
                    android:minHeight="54dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="@color/colorDark"
                    android:textColorHint="@color/color999"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/profile_intro"
                    android:textColor="@color/color999"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/introEt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/profile_field_bg"
                    android:gravity="center"
                    android:hint="@string/profile_intro_hint"
                    android:maxLength="120"
                    android:minHeight="72dp"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/colorDark"
                    android:textColorHint="@color/color999"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/countryTv"
                    style="@style/ProfileSimpleSelectText"
                    android:layout_marginTop="14dp"
                    android:hint="@string/profile_country_hint" />

                <TextView
                    android:id="@+id/nativeLanguageTv"
                    style="@style/ProfileSimpleSelectText"
                    android:layout_marginTop="10dp"
                    android:hint="@string/profile_native_language_hint" />

                <TextView
                    android:id="@+id/learningLanguageTv"
                    style="@style/ProfileSimpleSelectText"
                    android:layout_marginTop="10dp"
                    android:hint="@string/profile_learning_language_hint" />

                <TextView
                    android:id="@+id/genderTv"
                    style="@style/ProfileSimpleSelectText"
                    android:layout_marginTop="10dp"
                    android:hint="@string/profile_gender_hint" />

                <TextView
                    android:id="@+id/birthdayTv"
                    style="@style/ProfileSimpleSelectText"
                    android:layout_marginTop="10dp"
                    android:hint="@string/profile_birthday_hint" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sureBtn"
                    style="@style/buttonNormal"
                    android:layout_marginTop="24dp"
                    android:text="@string/wklogin_sure"
                    app:cornerRadius="@dimen/button_radian" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
