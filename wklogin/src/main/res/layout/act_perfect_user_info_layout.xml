<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profile_page_bg"
    android:orientation="vertical">

    <include layout="@layout/wk_title_bar_layout" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/profile_card_bg"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_edit_title"
                android:textColor="@color/colorDark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/profile_edit_subtitle"
                android:textColor="@color/color999"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/profile_display_name"
                android:textColor="@color/colorDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="88dp"
                    android:layout_height="88dp">

                    <com.chat.base.ui.components.AvatarView
                        android:id="@+id/avatarView"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="center" />

                    <TextView
                        android:id="@+id/countryFlagTv"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="start|bottom"
                        android:background="@drawable/profile_flag_bg"
                        android:gravity="center"
                        android:textSize="15sp" />

                    <View
                        android:id="@+id/onlineDotView"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/profile_online_dot_bg" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/coverIv"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="end|bottom"
                        android:src="@mipmap/ico_xiangji" />
                </FrameLayout>

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/nameEt"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/profile_field_bg"
                    android:gravity="center_vertical"
                    android:hint="@string/profile_name_hint"
                    android:maxLength="20"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:textColor="@color/colorDark"
                    android:textColorHint="@color/color999"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/profile_partner_photos"
                android:textColor="@color/colorDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/partnerPhotosLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/uploadPartnerPhotoBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/profile_field_bg"
                android:gravity="center"
                android:text="@string/profile_upload_phone_photo"
                android:textColor="#342C8C"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/profile_intro"
                android:textColor="@color/colorDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/introEt"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/profile_field_bg"
                android:gravity="top|start"
                android:hint="@string/profile_intro_hint"
                android:maxLength="160"
                android:padding="16dp"
                android:textColor="@color/colorDark"
                android:textColorHint="@color/color999"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ProfileLabelText"
                        android:text="@string/profile_country_region" />

                    <TextView
                        android:id="@+id/countryTv"
                        style="@style/ProfileSelectText"
                        android:text="@string/profile_select" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ProfileLabelText"
                        android:text="@string/profile_gender" />

                    <TextView
                        android:id="@+id/genderTv"
                        style="@style/ProfileSelectText"
                        android:text="@string/profile_select" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ProfileLabelText"
                        android:text="@string/profile_native_language" />

                    <TextView
                        android:id="@+id/nativeLanguageTv"
                        style="@style/ProfileSelectText"
                        android:text="@string/profile_select" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ProfileLabelText"
                        android:text="@string/profile_learning_language" />

                    <TextView
                        android:id="@+id/learningLanguageTv"
                        style="@style/ProfileSelectText"
                        android:text="@string/profile_select" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ProfileLabelText"
                android:layout_marginTop="18dp"
                android:text="@string/profile_birthday" />

            <TextView
                android:id="@+id/birthdayTv"
                style="@style/ProfileSelectText"
                android:text="" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ProfileLabelText"
                        android:text="@string/profile_height_optional" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/heightEt"
                        style="@style/ProfileEditText"
                        android:hint="170"
                        android:inputType="number"
                        android:maxLength="3" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ProfileLabelText"
                        android:text="@string/profile_weight_optional" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/weightEt"
                        style="@style/ProfileEditText"
                        android:hint="60"
                        android:inputType="number"
                        android:maxLength="3" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ProfileLabelText"
                android:layout_marginTop="18dp"
                android:text="@string/profile_education_optional" />

            <TextView
                android:id="@+id/educationTv"
                style="@style/ProfileSelectText"
                android:text="@string/profile_select" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/profile_tags"
                android:textColor="@color/colorDark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagResultTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="24dp"
                android:text="@string/profile_choose_tags_hint"
                android:textColor="@color/color999"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tagBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/profile_field_bg"
                android:gravity="center"
                android:text="@string/profile_choose_tags"
                android:textColor="#342C8C"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="#F8F7FF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sureBtn"
            style="@style/buttonNormal"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/profile_save"
            android:textSize="17sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
    </LinearLayout>
</LinearLayout>
