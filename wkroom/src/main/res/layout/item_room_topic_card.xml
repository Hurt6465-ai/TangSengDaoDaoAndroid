<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="170dp"
    android:layout_marginStart="30dp"
    android:layout_marginTop="9dp"
    android:layout_marginEnd="30dp"
    android:layout_marginBottom="13dp"
    android:background="@drawable/room_card_fallback"
    android:clipToOutline="true"
    android:elevation="5dp">

    <ImageView
        android:id="@+id/bgIv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/room_bg_01" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/room_card_bottom_soft_gradient" />

    <LinearLayout
        android:id="@+id/contentBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="26dp">

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:text="聊天室"
            android:textColor="#FFFFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/tagRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tagTv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:gravity="center"
                android:includeFontPadding="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="# 闲谈"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/langTv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/room_chip_white"
                android:gravity="center"
                android:includeFontPadding="true"
                android:minWidth="34dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="中文"
                android:textColor="#111827"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/metaRow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/creatorAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <TextView
                android:id="@+id/creatorNameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="发布者"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/sideAvatarStack"
                android:layout_width="130dp"
                android:layout_height="32dp">

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar6"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical" />

                <TextView
                    android:id="@+id/participantCountTv"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/room_participant_count_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="+8"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
