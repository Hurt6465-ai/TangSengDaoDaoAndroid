<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="174dp"
    android:layout_marginStart="14dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/room_card_fallback"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bgIv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/room_bg_01" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2A000000" />

    <TextView
        android:id="@+id/unreadTv"
        android:layout_width="44dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/room_unread_badge"
        android:gravity="center"
        android:text="4"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/langTv"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/room_chip_white"
                android:gravity="center"
                android:minWidth="58dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="中文"
                android:textColor="#111827"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagTv"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/room_chip_blue"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="# 学习"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hotTv"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/room_chip_green"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="热议"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingEnd="60dp"
            android:text="556"
            android:textColor="#FFFFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/metaTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="发布者 发布"
            android:textColor="#E9FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/groupAvatarBox"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/room_avatar_ring"
            android:padding="3dp">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/cardAvatar1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|top" />

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/cardAvatar2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="end|top" />

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/cardAvatar3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|bottom" />

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/cardAvatar4"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="end|bottom" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
