<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="138dp"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="10dp"
    android:background="#6D9EA4"
    android:clipToOutline="true">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#26000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="13dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/langTv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:background="#EFFFFFFF"
                android:gravity="center"
                android:minWidth="38dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="中文"
                android:textColor="#111827"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagTv"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="6dp"
                android:background="#3B82F6"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="# 闲谈"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:paddingEnd="34dp"
            android:text="聊天室"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/creatorAvatar"
                android:layout_width="58dp"
                android:layout_height="58dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/sideAvatarRow"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar4"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar5"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar6"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
