<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:layout_marginStart="20dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/room_card_fallback"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/bgIv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/room_bg_01" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#50000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp">

        <TextView
            android:id="@+id/titleTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="true"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:paddingEnd="28dp"
            android:text="聊天室"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/langTv"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:background="@drawable/room_chip_white"
                android:gravity="center"
                android:minWidth="34dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="中文"
                android:textColor="#111827"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tagTv"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:text="# 闲谈"
                android:textColor="#FFFFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="bottom|center_vertical"
            android:orientation="horizontal"
            android:paddingTop="5dp">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/creatorAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp" />

            <TextView
                android:id="@+id/creatorNameTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="true"
                android:maxLines="1"
                android:text="发布者"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/sideAvatarRow"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="14dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar1"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar2"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar3"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar4"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar5"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp" />

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/sideAvatar6"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp" />

                <TextView
                    android:id="@+id/participantCountTv"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/room_avatar_ring"
                    android:gravity="center"
                    android:text="+8"
                    android:textColor="#111827"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
