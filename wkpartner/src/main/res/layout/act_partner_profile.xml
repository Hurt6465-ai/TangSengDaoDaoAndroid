<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F3F7"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false">

    <!--
        封面和资料区统一放进 AppBarLayout，由下面真正可滚动的作品 RecyclerView
        驱动折叠。避免 NestedScrollView 再嵌套 RecyclerView 导致瀑布流只测出一小截高度。
    -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fitsSystemWindows="false"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:translationZ="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:fitsSystemWindows="false"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:scrimAnimationDuration="280"
            app:statusBarScrim="@android:color/transparent">

            <ImageView
                android:id="@+id/coverIv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/partner_profile"
                android:fitsSystemWindows="false"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_partner_cover_default"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.7" />

            <View
                android:id="@+id/coverGradientTop"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_partner_cover_gradient_top"
                app:layout_collapseMode="pin" />

            <View
                android:id="@+id/coverGradientBottom"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_partner_cover_mask"
                app:layout_collapseMode="parallax" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>

        <LinearLayout
            android:id="@+id/contentSheetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_partner_content_sheet"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="0dp"
            app:layout_scrollFlags="scroll">

            <RelativeLayout
                android:id="@+id/profileHeaderLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:id="@+id/avatarGlowLayout"
                    android:layout_width="97dp"
                    android:layout_height="97dp"
                    android:layout_alignParentStart="true"
                    android:layout_marginTop="-44dp"
                    android:background="@drawable/bg_partner_avatar_glow"
                    android:elevation="6dp">

                    <com.chat.base.ui.components.AvatarView
                        android:id="@+id/avatarView"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_partner_avatar_border" />

                    <View
                        android:id="@+id/onlineIndicator"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="11dp"
                        android:layout_marginEnd="11dp"
                        android:background="@drawable/bg_partner_online_dot"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/nameRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/avatarGlowLayout"
                    android:layout_marginTop="6dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/nameTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="230dp"
                        android:textColor="#1A1A2E"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/sexAgeTv"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_partner_gender_age"
                        android:gravity="center"
                        android:minWidth="42dp"
                        android:paddingStart="9dp"
                        android:paddingEnd="9dp"
                        android:textColor="#E82FA2"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/profileSelfEditChip"
                        android:layout_width="wrap_content"
                        android:layout_height="26dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="1dp"
                        android:background="@drawable/bg_partner_glass_chip"
                        android:gravity="center"
                        android:minWidth="58dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/partner_edit_profile"
                        android:textColor="#666672"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/profileLastOnlineGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/profileTimeIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_partner_time"
                            app:tint="#A2A2AD" />

                        <TextView
                            android:id="@+id/profileLastOnlineTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="96dp"
                            android:textColor="#8F8F9A"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/langLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/nameRow"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/nativeLangTv"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_partner_profile_language_native"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.03"
                        android:maxLines="1"
                        android:maxWidth="142dp"
                        android:minWidth="32dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="#347D71"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/langToTv"
                        android:layout_width="20dp"
                        android:layout_height="22dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="⇋"
                        android:textColor="#9AA2B1"
                        android:textSize="12sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/learningLangTv"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_partner_profile_language_learning"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.03"
                        android:maxLines="1"
                        android:maxWidth="142dp"
                        android:minWidth="32dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:textColor="#3977A8"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/introSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/introTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:padding="0dp"
                    android:textColor="#3E3E4A"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/introMoreTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:text="@string/partner_expand_all"
                    android:textColor="#6C4DFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tagSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:id="@+id/tagCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tagLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/photoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="@string/partner_photos"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/photoLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/feedWorksSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="#EEF1F5"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:visibility="gone">

                <!--
                    内容流里的“作品”标题。吸顶时变 INVISIBLE 但保留占位，避免跳动。
                -->
                <TextView
                    android:id="@+id/feedWorksTitleTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="@string/partner_works"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!--
        作品区是 CoordinatorLayout 唯一的滚动子 View。Fragment 内 RecyclerView
        保持正常回收、分页和嵌套滚动，不再依赖 wrap_content 撑开整个列表。
    -->
    <FrameLayout
        android:id="@+id/feedWorksContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#EEF1F5"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!--
        ============== 固定顶部用户名栏 ==============
        独立 overlay，CoordinatorLayout 最外层。
        永远显示，永不被 AppBar 折叠，永不 GONE / alpha=0。
        白底、高度 = 状态栏 + 56dp（运行时 padding 设置）、elevation=0、无阴影。
        包含：返回按钮 / 用户名 / 国家·在线状态 / 更多按钮。
    -->
    <LinearLayout
        android:id="@+id/fixedProfileTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:stateListAnimator="@null"
        android:translationZ="0dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="12dp"
            android:background="@android:color/transparent"
            android:padding="9dp"
            android:src="@drawable/ic_partner_back"
            app:tint="#FFFFFFFF" />

        <LinearLayout
            android:id="@+id/topBarTitleLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toolbarTitleTv"
                android:alpha="0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="220dp"
                android:textColor="#FF202033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/toolbarMetaLayout"
                android:alpha="0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/toolbarCountryGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/toolbarCountryIcon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_partner_location_pin"
                        app:tint="#FF9A9AA6" />

                    <TextView
                        android:id="@+id/toolbarCountryTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="90dp"
                        android:textColor="#FF8C8C99"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/toolbarLastOnlineGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/toolbarTimeIcon"
                        android:layout_width="11dp"
                        android:layout_height="11dp"
                        android:src="@drawable/ic_partner_time"
                        app:tint="#FF9A9AA6" />

                    <TextView
                        android:id="@+id/toolbarLastOnlineTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="140dp"
                        android:textColor="#FF8C8C99"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/editBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:padding="9dp"
            android:src="@drawable/ic_partner_more_horizontal"
            app:tint="#FFFFFFFF" />
    </LinearLayout>

    <!--
        “作品”标题不再单独吸顶。作品滚动时只保留 fixedProfileTopBar，
        内容里的标题会和资料区一起自然滚出屏幕。
    -->

    <FrameLayout
        android:id="@+id/helloBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/transparent"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/helloBtnLayout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_partner_hello_button"
            android:elevation="0dp"
            android:translationZ="0dp">

            <TextView
                android:id="@+id/helloBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/partner_add_friend"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/helloBtnProgress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:indeterminateTint="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
