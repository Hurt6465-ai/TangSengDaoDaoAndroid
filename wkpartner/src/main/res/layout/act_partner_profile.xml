<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- ===== TOP APP BAR ===== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="#3B2BC7"
            app:statusBarScrim="#3B2BC7"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false">

            <!-- 封面图 -->
            <ImageView
                android:id="@+id/coverIv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/partner_profile"
                android:scaleType="centerCrop"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.65" />

            <!-- 封面渐变遮罩（底部向上渐黑，增强文字可读性） -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_partner_cover_mask"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.65" />

            <!-- Toolbar 区域 -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- 返回按钮 -->
                    <ImageView
                        android:id="@+id/backBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_partner_glass_icon_btn"
                        android:padding="9dp"
                        android:src="@drawable/ic_partner_back"
                        app:tint="#FFFFFFFF" />

                    <!-- 折叠后显示的标题（带淡入动画） -->
                    <TextView
                        android:id="@+id/toolbarTitleTv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:ellipsize="end"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:maxWidth="180dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <!-- 编辑按钮（仅本人可见） -->
                    <ImageView
                        android:id="@+id/editBtn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_partner_glass_icon_btn"
                        android:padding="9dp"
                        android:src="@drawable/ic_partner_edit"
                        app:tint="#FFFFFFFF" />

                </FrameLayout>
            </androidx.appcompat.widget.Toolbar>

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ===== 主体滚动区域 ===== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 白色内容卡片，顶部圆角上浮覆盖封面底部 -->
        <LinearLayout
            android:id="@+id/contentSheetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_partner_content_sheet"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- ─── 个人信息头部区域 ─── -->
            <FrameLayout
                android:id="@+id/profileHeaderLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="4dp">

                <!-- 头像光晕容器（负 marginTop 上浮到封面上方） -->
                <FrameLayout
                    android:id="@+id/avatarGlowLayout"
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:layout_gravity="start|top"
                    android:layout_marginTop="-52dp"
                    android:background="@drawable/bg_partner_avatar_glow"
                    android:elevation="12dp">

                    <com.chat.base.ui.components.AvatarView
                        android:id="@+id/avatarView"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_partner_avatar_border" />
                </FrameLayout>

                <!-- 姓名 + 性别年龄 + 语言，垂直排列在头像右侧空间下方 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:layout_marginTop="72dp"
                    android:orientation="vertical">

                    <!-- 姓名行 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nameTv"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:letterSpacing="-0.01"
                            android:maxLines="1"
                            android:textColor="#0D0D0D"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <!-- 性别年龄标签胶囊 -->
                        <TextView
                            android:id="@+id/sexAgeTv"
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_partner_gender_age"
                            android:gravity="center"
                            android:minWidth="44dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:textColor="#E82FA2"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- 语言交换行 -->
                    <LinearLayout
                        android:id="@+id/langLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_partner_lang_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/nativeLangTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#3B2BC7"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="⇄"
                            android:textColor="#9B8FE8"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/learningLangTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#3B2BC7"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

            <!-- 细分割线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="#F0F0F5" />

            <!-- ─── 介绍 Section ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Section 标题行（左侧色块装饰） -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_partner_section_accent"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="介绍"
                        android:textColor="#0D0D0D"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/introTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="6dp"
                    android:maxLines="3"
                    android:textColor="#444455"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/introMoreTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="2dp"
                    android:drawablePadding="3dp"
                    android:gravity="center_vertical"
                    android:text="展开"
                    android:textColor="#3B2BC7"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- ─── 标签 Section ─── -->
            <LinearLayout
                android:id="@+id/tagSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:foreground="?attr/selectableItemBackground"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_partner_section_accent"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="标签"
                        android:textColor="#0D0D0D"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/tagCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tagLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- ─── 语伴图片 Section ─── -->
            <LinearLayout
                android:id="@+id/photoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_partner_section_accent"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="语伴图片"
                        android:textColor="#0D0D0D"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/photoLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 底部占位，给悬浮按钮留空间 -->
            <Space
                android:id="@+id/bottomActionSpace"
                android:layout_width="match_parent"
                android:layout_height="120dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== 底部悬浮操作栏（打招呼/发消息） ===== -->
    <LinearLayout
        android:id="@+id/helloBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_partner_bottom_gradient"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/helloBtnLayout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_partner_hello_button"
            android:elevation="8dp"
            android:translationZ="8dp">

            <TextView
                android:id="@+id/helloBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/partner_say_hello"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/helloBtnProgress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:indeterminateTint="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
