<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5FF"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fitsSystemWindows="true"
            app:contentScrim="@android:color/transparent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:scrimAnimationDuration="260"
            app:statusBarScrim="@android:color/transparent">

            <!-- 封面图 -->
            <ImageView
                android:id="@+id/coverIv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/partner_profile"
                android:fitsSystemWindows="true"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_partner_cover_default"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.72" />

            <View
                android:id="@+id/coverGradientTop"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_gravity="top"
                android:background="@drawable/bg_partner_cover_gradient_top"
                app:layout_collapseMode="pin" />

            <!-- 顶部工具栏 -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_collapseMode="pin">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/backBtn"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:alpha="0"
                        android:visibility="gone" />

                    <!-- 上滑后显示的迷你资料 -->
                    <LinearLayout
                        android:id="@+id/toolbarTitleLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <com.chat.base.ui.components.AvatarView
                            android:id="@+id/toolbarAvatarView"
                            android:layout_width="24dp"
                            android:layout_height="24dp" />

                        <TextView
                            android:id="@+id/toolbarTitleTv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:maxWidth="180dp"
                            android:textColor="#FFFFFFFF"
                            android:textSize="17sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/editBtn"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/bg_partner_glass_icon_btn"
                        android:padding="10dp"
                        android:src="@drawable/ic_partner_edit"
                        app:tint="#FFFFFFFF" />
                </FrameLayout>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 注意这里的 app:behavior_overlapTop="46dp"，它让内容区上浮遮挡封面，实现半压效果 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:behavior_overlapTop="46dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 内容区改为 ConstraintLayout 实现精准重叠 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentSheetLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 纯白色的卡片背景，从 46dp 开始，给头像留出悬浮空间 -->
            <View
                android:id="@+id/sheetBackground"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="46dp"
                android:background="@drawable/bg_partner_content_sheet"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 压在交界处的头像 -->
            <FrameLayout
                android:id="@+id/avatarGlowLayout"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_partner_avatar_glow"
                android:elevation="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.chat.base.ui.components.AvatarView
                    android:id="@+id/avatarView"
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_partner_avatar_border" />

                <View
                    android:id="@+id/onlineIndicator"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="13dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_partner_online_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- 移到白色区域的用户名和性别 -->
            <LinearLayout
                android:id="@+id/nameLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/avatarGlowLayout">

                <!-- 去掉了阴影，改成了深色字 -->
                <TextView
                    android:id="@+id/nameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="220dp"
                    android:textColor="#1E1E2A"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sexAgeTv"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_partner_gender_age"
                    android:gravity="center"
                    android:minWidth="42dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 移到用户名下方的语言区，优化了颜色使其更高级 -->
            <LinearLayout
                android:id="@+id/langLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/nameLayout">

                <TextView
                    android:id="@+id/nativeLangTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#666677"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_partner_lang_exchange_simple"
                    app:tint="#9696A6" />

                <TextView
                    android:id="@+id/learningLangTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#7B5BFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 增加一条视觉分隔线，提升高级感 -->
            <View
                android:id="@+id/headerDivider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="24dp"
                android:background="#15000000"
                app:layout_constraintTop_toBottomOf="@id/langLayout" />

            <LinearLayout
                android:id="@+id/introSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:layout_constraintTop_toBottomOf="@id/headerDivider">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="介绍"
                    android:textColor="#1E1E2A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/introTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="6dp"
                    android:maxLines="3"
                    android:textColor="#4A4A56"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/introMoreTv"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:text="展开全部"
                    android:textColor="#7B5BFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tagSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/introSection">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="兴趣标签"
                    android:textColor="#1E1E2A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:id="@+id/tagCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tagLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/photoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/tagSection">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="相册"
                    android:textColor="#1E1E2A"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/photoLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <Space
                android:id="@+id/bottomActionSpace"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                app:layout_constraintTop_toBottomOf="@id/photoCard" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部打招呼区域保持不变 -->
    <FrameLayout
        android:id="@+id/helloBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_partner_bottom_gradient"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/helloBtnLayout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_partner_hello_button"
            android:elevation="8dp"
            android:translationZ="8dp">

            <TextView
                android:id="@+id/helloBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/partner_say_hello"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/helloBtnProgress"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:indeterminateTint="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
