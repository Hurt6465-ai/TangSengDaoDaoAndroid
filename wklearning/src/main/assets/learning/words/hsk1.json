      "id": "greeting_001",
      "word": "你好",
      "pinyin": "nǐ hǎo",
      "translations": {
        "my": "မင်္ဂလာပါ",
        "en": "Hello"
      },
      "example": "你好，很高兴认识你。",
      "exampleTranslations": {
        "my": "မင်္ဂလာပါ၊ တွေ့ရတာဝမ်းသာပါတယ်။",
        "en": "Hello, nice to meet you."
      },
      "audio": "audio/words/greeting_001.mp3",
      "level": "A1",
      "phonetic_my": "နီ ဟောင်",
      "example_pinyin": "Nǐ hǎo, hěn gāoxìng rènshi nǐ.",
      "usage_scene": "见面、聊天开场",
      "notes": "你好偏日常，您好更礼貌。",
      "synonyms": [
        "您好"
      ],
      "antonyms": []
    },
    {
      "id": "greeting_002",
      "word": "谢谢",
      "pinyin": "xiè xie",
      "translations": {
        "my": "ကျေးဇူးတင်ပါတယ်",
        "en": "Thank you"
      },
      "example": "谢谢你的帮助。",
      "exampleTranslations": {
        "my": "ကူညီပေးတာ ကျေးဇူးတင်ပါတယ်။",
        "en": "Thank you for your help."
      },
      "audio": "audio/words/greeting_002.mp3",
      "level": "A1",
      "phonetic_my": "ရှဲ့ ရှဲ့",
      "example_pinyin": "Xièxie nǐ de bāngzhù.",
      "usage_scene": "表达感谢、收到帮助后使用",
      "notes": "谢谢可以单独使用，也可以说“谢谢你”。",
      "synonyms": [
        "感谢"
      ],
      "antonyms": []
    },
    {
      "id": "greeting_003",
      "word": "再见",
      "pinyin": "zài jiàn",
      "translations": {
        "my": "နောက်မှတွေ့မယ်",
        "en": "Goodbye"
      },
      "example": "明天再见。",
      "exampleTranslations": {
        "my": "မနက်ဖြန် ပြန်တွေ့မယ်။",
        "en": "See you tomorrow."
      },
      "audio": "audio/words/greeting_003.mp3",
      "level": "A1",
      "phonetic_my": "ဇိုင်း ကျန်",
      "example_pinyin": "Míngtiān zàijiàn.",
      "usage_scene": "离开、聊天结束、告别",
      "notes": "口语里也可以说“拜拜”。",
      "synonyms": [
        "拜拜"
      ],
      "antonyms": [
        "你好"
      ]
    },
    {
      "id": "greeting_004",
      "word": "可以",
      "pinyin": "kě yǐ",
      "translations": {
        "my": "ရပါတယ်",
        "en": "Okay / can"
      },
      "example": "这样可以吗？",
      "exampleTranslations": {
        "my": "ဒီလို ရမလား။",
        "en": "Is this okay?"
      },
      "audio": "audio/words/greeting_004.mp3",
      "level": "A1",
      "phonetic_my": "ခယ် ယီ",
      "example_pinyin": "Zhèyàng kěyǐ ma?",
      "usage_scene": "同意、请求许可、确认是否可以",
      "notes": "“可以吗？”常用于礼貌询问。",
      "synonyms": [
        "行",
        "能"
      ],
      "antonyms": [
        "不可以"
      ]
    },
    {
      "id": "greeting_005",
      "word": "不可以",
      "pinyin": "bù kě yǐ",
      "translations": {
