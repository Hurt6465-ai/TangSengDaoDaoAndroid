<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_feed_sheet_top">

    <LinearLayout
        android:id="@+id/commentContentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_feed_comment_drag_handle" />

        <LinearLayout
            android:id="@+id/commentAuthorHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/commentAuthorAvatar"
                android:layout_width="42dp"
                android:layout_height="42dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/commentAuthorNameTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#111827"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/commentAuthorDotTv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:text="·"
                    android:textColor="#9CA3AF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/commentAuthorFollowTv"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_feed_follow_button"
                    android:gravity="center"
                    android:minWidth="60dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/feed_follow"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/commentCloseBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@null"
                android:contentDescription="@string/feed_close"
                android:src="@drawable/ic_feed_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/commentCaptionTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:paddingStart="16dp"
            android:paddingTop="0dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:textColor="#111827"
            android:textSize="14sp"
            android:visibility="gone" />

        <View
            android:id="@+id/commentCaptionDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF0F3"
            android:visibility="gone" />

        <TextView
            android:id="@+id/commentTitleTv"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/feed_comment_title"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/commentRecordHintTv"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="@string/feed_voice_hold_to_talk"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/commentInputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_feed_comment_input_bar"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <EditText
                android:id="@+id/commentEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_feed_comment_input"
                android:gravity="center_vertical"
                android:hint="@string/feed_comment_hint"
                android:imeOptions="actionSend|flagNoExtractUi"
                android:includeFontPadding="false"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3"
                android:minHeight="46dp"
                android:paddingStart="15dp"
                android:paddingTop="10dp"
                android:paddingEnd="15dp"
                android:paddingBottom="10dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/commentSendBtn"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_feed_comment_voice_button"
                android:contentDescription="@string/feed_voice_hold_to_talk"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_feed_mic_white" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/commentRecordPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="92dp"
        android:background="@drawable/bg_feed_comment_record_panel"
        android:elevation="18dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/commentRecordTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feed_voice_recording_title"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.chat.uikit.view.voice.LineWaveVoiceView
            android:id="@+id/commentRecordWaveView"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="4dp"
            app:voiceLineColor="#FFFF3B5C"
            app:voiceLineWidth="3dp"
            app:voiceTextColor="#FFFF3B5C"
            app:voiceTextSize="14sp" />

        <TextView
            android:id="@+id/commentRecordTimerTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="00:00 / 01:00"
            android:textColor="#6B7280"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/commentRecordCancelTv"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_feed_comment_record_cancel"
            android:gravity="center"
            android:minWidth="132dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/feed_voice_drag_cancel"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
