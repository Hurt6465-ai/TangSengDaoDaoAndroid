<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/commentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="15dp"
    android:paddingTop="10dp"
    android:paddingEnd="15dp"
    android:paddingBottom="8dp">

    <com.chat.base.ui.components.AvatarView
        android:id="@+id/commentAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/commentNameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8A8F98"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/commentContentTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#111827"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/commentVoiceLayout"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_feed_comment_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <com.chat.uikit.view.CircleProgress
                android:id="@+id/commentVoicePlayBtn"
                android:layout_width="34dp"
                android:layout_height="34dp"
                app:shadowColor="#FFFFFFFF"
                app:progressColor="#E91E63"
                app:playColor="#E91E63" />

            <com.chat.uikit.view.WaveformView
                android:id="@+id/commentVoiceWaveform"
                android:layout_width="118dp"
                android:layout_height="20dp"
                android:layout_marginStart="7dp" />

            <TextView
                android:id="@+id/commentVoiceTimeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/commentTimeTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A0A4AD"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/commentReplyTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/feed_comment_reply"
                android:textColor="#6B7280"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/commentStateTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#EF4444"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/commentExpandTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#8A8F98"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/commentLikeTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#8A8F98"
        android:textSize="12sp" />
</LinearLayout>
