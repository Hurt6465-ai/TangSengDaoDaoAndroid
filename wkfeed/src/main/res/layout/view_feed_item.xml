<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.chat.feed.browse.NestedScrollableHost
        android:id="@+id/imagePagerHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/imagePager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.chat.feed.browse.NestedScrollableHost>

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="zoom"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/coverView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/videoLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <View
        android:id="@+id/bottomMask"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_feed_bottom_mask" />

    <TextView
        android:id="@+id/imageIndicatorTv"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_feed_chip_dark"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="98dp"
        android:gravity="center"
        android:orientation="vertical">

        <com.chat.base.ui.components.AvatarView
            android:id="@+id/avatarView"
            android:layout_width="52dp"
            android:layout_height="52dp" />

        <ImageButton
            android:id="@+id/likeBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@null"
            android:scaleType="center"
            android:src="@drawable/ic_feed_heart" />

        <TextView
            android:id="@+id/likeCountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/commentBtn"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@null"
            android:scaleType="center"
            android:src="@drawable/ic_feed_comment" />

        <TextView
            android:id="@+id/commentCountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/descPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="82dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="34dp">

        <TextView
            android:id="@+id/nameTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/metaTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D8FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/descTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/actionBtn"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_feed_action_button"
            android:gravity="center"
            android:minWidth="96dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bigHeartView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:src="@drawable/ic_feed_heart_fill"
        android:visibility="gone" />
</FrameLayout>
