<?xml version="1.0" encoding="utf-8"?>
<com.chat.feed.browse.FeedGestureLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/feedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.chat.feed.browse.NestedScrollableHost
        android:id="@+id/imagePagerHost"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/imagePager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.chat.feed.browse.NestedScrollableHost>

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:resize_mode="zoom"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ImageView
        android:id="@+id/coverView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />


    <ProgressBar
        android:id="@+id/videoLoading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/playPauseView"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_gravity="center"
        android:alpha="0.96"
        android:background="@drawable/bg_feed_play_pause"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:paddingStart="5dp"
        android:text="▶"
        android:textColor="#FFFFFFFF"
        android:textSize="42sp"
        android:visibility="gone" />

    <View
        android:id="@+id/bottomMask"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_feed_bottom_mask" />

    <TextView
        android:id="@+id/imageIndicatorTv"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="34dp"
        android:background="@drawable/bg_feed_chip_dark"
        android:gravity="center"
        android:minWidth="48dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="64dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="92dp"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/likeBtn"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@null"
            android:scaleType="center"
            android:src="@drawable/ic_feed_heart" />

        <TextView
            android:id="@+id/likeCountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/commentBtn"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@null"
            android:scaleType="center"
            android:src="@drawable/ic_feed_comment" />

        <TextView
            android:id="@+id/commentCountTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-4dp"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/shareBtn"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@null"
            android:scaleType="center"
            android:src="@drawable/ic_feed_share" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/descPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginEnd="82dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:id="@+id/userRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.chat.base.ui.components.AvatarView
                android:id="@+id/avatarView"
                android:layout_width="42dp"
                android:layout_height="42dp" />

            <TextView
                android:id="@+id/nameTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/actionBtn"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_feed_follow_button"
                android:gravity="center"
                android:minWidth="64dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/metaTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#D8FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/descTv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bigHeartView"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:alpha="0"
        android:src="@drawable/ic_feed_heart_fill"
        android:visibility="gone" />
</com.chat.feed.browse.FeedGestureLayout>
