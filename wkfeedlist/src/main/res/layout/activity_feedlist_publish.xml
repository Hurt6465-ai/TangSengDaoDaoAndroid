<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feedlist_page_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="44dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/feedlistPublishTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedlist_publish_title"
                android:textColor="@color/feedlist_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/feedlistPublishTextEt"
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_feedlist_publish_input"
                android:gravity="top|start"
                android:hint="@string/feedlist_publish_text_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="520"
                android:padding="14dp"
                android:textColor="@color/feedlist_text"
                android:textColorHint="@color/feedlist_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/feedlistCopyrightNoticeTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/feedlist_tiktok_copyright_notice"
                android:textColor="@color/feedlist_danger"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/feedlistPublishHintTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/feedlist_publish_storage_hint"
                android:textColor="@color/feedlist_secondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/feedlistPreviewRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <FrameLayout
                android:id="@+id/feedlistTikTokPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="14dp"
                android:background="@android:color/black"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/feedlistTikTokCoverIv"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/feedlist_tiktok"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_feedlist_tiktok_scrim" />

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_feedlist_play"
                    android:contentDescription="@string/feedlist_play"
                    android:padding="16dp"
                    android:src="@drawable/ic_feedlist_play" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/feedlistTikTokTitleTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/feedlistTikTokAuthorTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#E6FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/feedlistPickImagesBtn"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_feedlist_publish_action"
                android:gravity="center"
                android:text="@string/feedlist_pick_images"
                android:textColor="@color/feedlist_text"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/feedlistUploadProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="22dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/feedlistUploadProgressTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/feedlist_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/feedlistPublishSubmitBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_feedlist_publish_submit"
                android:gravity="center"
                android:text="@string/feedlist_publish_submit"
                android:textColor="@color/feedlist_on_accent"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/feedlistPublishCloseTv"
        android:layout_width="52dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/feedlist_text"
        android:textSize="28sp" />
</FrameLayout>
