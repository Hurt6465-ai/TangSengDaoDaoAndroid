<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/feedlist_page_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="44dp"
            android:paddingEnd="18dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/feedlistPublishTitleTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/feedlist_publish_title"
                android:textColor="@color/feedlist_text"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/feedlistPublishTextEt"
                android:layout_width="match_parent"
                android:layout_height="122dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_feedlist_publish_input"
                android:gravity="top|start"
                android:hint="@string/feedlist_publish_text_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="280"
                android:padding="14dp"
                android:textColor="@color/feedlist_text"
                android:textColorHint="@color/feedlist_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/feedlistPublishHintTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/feedlist_publish_storage_hint"
                android:textColor="@color/feedlist_secondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/feedlistPreviewRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/feedlistTikTokBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_feedlist_publish_input"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/feedlistTikTokUrlEt"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@android:color/transparent"
                    android:hint="@string/feedlist_tiktok_publish_url_hint"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textColor="@color/feedlist_text"
                    android:textColorHint="@color/feedlist_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/feedlistTikTokResolveBtn"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_feedlist_publish_action"
                    android:gravity="center"
                    android:text="@string/feedlist_tiktok_publish_preview"
                    android:textColor="@color/feedlist_text"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/feedlistTikTokPreview"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/feedlistTikTokCoverIv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_feedlist_publish_action"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@color/feedlist_text"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/feedlistTikTokTitleTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:background="@color/feedlist_media_scrim"
                        android:maxLines="2"
                        android:padding="10dp"
                        android:textColor="@color/feedlist_on_accent"
                        android:textSize="13sp" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/feedlistPickImagesBtn"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feedlist_publish_action"
                    android:gravity="center"
                    android:text="@string/feedlist_pick_images"
                    android:textColor="@color/feedlist_text"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/feedlistPickTikTokBtn"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_feedlist_publish_action"
                    android:gravity="center"
                    android:text="@string/feedlist_pick_tiktok"
                    android:textColor="@color/feedlist_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/feedlistUploadProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="22dp"
                android:max="100"
                android:visibility="gone" />

            <TextView
                android:id="@+id/feedlistUploadProgressTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/feedlist_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/feedlistPublishSubmitBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_feedlist_publish_submit"
                android:gravity="center"
                android:text="@string/feedlist_publish_submit"
                android:textColor="@color/feedlist_on_accent"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/feedlistPublishCloseTv"
        android:layout_width="52dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="10dp"
        android:gravity="center"
        android:text="×"
        android:textColor="@color/feedlist_text"
        android:textSize="28sp" />
</FrameLayout>
